APP_NAME=CySkillShare
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Bangkok

# Docker Compose service hostname (not 127.0.0.1)
DB_HOST=db
DB_PORT=3306
DB_DATABASE=cyskillshare
DB_USERNAME=cyskillshare
DB_PASSWORD=cyskillshare
DB_SOCKET=
DB_ROOT_PASSWORD=rootsecret

SESSION_NAME=cyskillshare_session
SESSION_LIFETIME=7200
SESSION_SECURE=false
SESSION_SAME_SITE=Lax
