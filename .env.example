APP_NAME=CySkillShare
# Use APP_ENV=development and APP_DEBUG=true only on a private workstation.
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Bangkok

# Docker Compose service hostname (not 127.0.0.1)
# Never set DB_USERNAME=root for the application.
DB_HOST=db
DB_PORT=3306
DB_DATABASE=cyskillshare
DB_USERNAME=cyskillshare
DB_PASSWORD=cyskillshare
DB_SOCKET=
DB_ROOT_PASSWORD=rootsecret

# phpMyAdmin (development) — http://localhost:8081
PHPMYADMIN_PORT=8081

SESSION_NAME=cyskillshare_session
# Idle session timeout in seconds
SESSION_LIFETIME=7200
SESSION_SECURE=false
SESSION_SAME_SITE=Lax
